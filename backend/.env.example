# Copy this file to backend/.env and fill it in. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# True for local development only. Leave False (or unset) in production.
DJANGO_DEBUG=True

# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed when the React app is served from a different origin than the API
# (locally the Vite proxy makes them the same origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deployed only (Railway preview, see DEPLOYMENT.md). Leave unset locally.
# DATABASE_URL: a postgres:// connection URL. When set, it replaces SQLite.
# DJANGO_BEHIND_HTTPS_PROXY: true when a proxy in front ends HTTPS (Railway does).
# DATABASE_URL=
# DJANGO_BEHIND_HTTPS_PROXY=true

# Production only: PostgreSQL on AWS RDS (see DATABASES in config/settings.py).
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432

# Production only: S3 bucket for content files (see STORAGES in config/settings.py).
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-2
