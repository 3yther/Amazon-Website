# Copy to frontend/.env.local if you need it. Never commit real .env files.

# Leave empty in development: the Vite proxy sends /api to Django.
# Leave it empty on the Railway preview too: there the frontend service's Caddy
# server sends /api to Django (see Caddyfile and DEPLOYMENT.md).
# Only set it to the API's full origin if the front end is ever hosted on a
# different site from the API, e.g. VITE_API_BASE_URL=https://api.example.com
# (that also needs CORS set up, and cross-site cookies are blocked by Safari).
VITE_API_BASE_URL=
